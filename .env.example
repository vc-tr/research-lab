# LLM Provider: "anthropic" | "openai" | "groq"
# Groq has a generous free tier: https://console.groq.com/
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
DEFAULT_MODEL=claude-sonnet-4-6
# Recommended free model: llama-3.3-70b-versatile (set DEFAULT_MODEL when LLM_PROVIDER=groq)

# Pinecone (set USE_PINECONE=false to use in-memory vector store)
USE_PINECONE=true
PINECONE_API_KEY=
PINECONE_INDEX_NAME=research-lab

# Search (leave TAVILY_API_KEY empty to use DuckDuckGo)
TAVILY_API_KEY=

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-lab

# Data
DATA_DIR=data/papers

# API
API_HOST=0.0.0.0
API_PORT=8000
